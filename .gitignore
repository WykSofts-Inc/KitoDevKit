.build/
.swiftpm/
Package.resolved
*.xcodeproj
Sample/.build/
# Sample's .xcodeproj IS committed (generated by xcodegen from project.yml)
# so a developer can clone and open with zero extra tooling — only the
# per-user Xcode state inside it is ignored.
!Sample/KitoSample.xcodeproj
Sample/KitoSample.xcodeproj/project.xcworkspace/xcuserdata/
Sample/KitoSample.xcodeproj/xcuserdata/
